# Frontend may copy this value to frontend/.env.local (Vite reads env from its root).
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1

# Fake mode is default and works offline. Use Ollama optionally.
LLM_PROVIDER=fake
LLM_API_KEY=
LLM_MODEL_ID=
LLM_TIMEOUT_SECONDS=30
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# Set to true only when serving the API over HTTPS.
COOKIE_SECURE=false
